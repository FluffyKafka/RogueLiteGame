  statsTypeInfo:
  - origin: 0
    description: "\u751F\u547D\u4E0D\u4F1A\u8D85\u8FC7\u6B64\u4E0A\u9650"
  - origin: 1
    description: "\u53D7\u5230\u653B\u51FB\u65F6\uFF0C\u627F\u53D7\u7269\u7406\u4F24\u5BB3\u91CF\u7B49\u4E8E\u8F93\u5165\u7269\u7406\u4F24\u5BB3\u91CF\u51CF\u53BB\u62A4\u7532\u503C"
  - origin: 2
    description: "\u53D7\u5230\u653B\u51FB\u65F6\u95EA\u907F\u6B64\u6B21\u653B\u51FB\u7684\u51E0\u7387\uFF0C\u88AB\u95EA\u907F\u7684\u653B\u51FB\u4E0D\u9020\u6210\u4F24\u5BB3\u6216\u9B54\u6CD5\u6548\u679C"
  - origin: 3
    description: "\u53D7\u5230\u653B\u51FB\u65F6\uFF0C\u627F\u53D7\u9B54\u6CD5\u4F24\u5BB3\u91CF\u7B49\u4E8E\u8F93\u5165\u9B54\u6CD5\u4F24\u5BB3\u91CF\u51CF\u53BB\u9B54\u6CD5\u62B5\u6297\u3002\u82E5\u9B54\u6CD5\u4F24\u5BB3\u4E3A0\u5219\u4E0D\u4F1A\u65BD\u52A0\u9B54\u6CD5\u6548\u679C"
  - origin: 4
    description: "\u9020\u6210\u7684\u7269\u7406\u4F24\u5BB3"
  - origin: 5
    description: "\u51FB\u4E2D\u654C\u4EBA\u5F31\u70B9\u7684\u51E0\u7387\uFF0C\u51FB\u4E2D\u654C\u4EBA\u5F31\u70B9\u5C06\u5BF9\u654C\u4EBA\u9020\u6210\u9AD8\u4E8E\u5E73\u5E38\u7684\u4F24\u5BB3"
  - origin: 6
    description: "\u51FB\u4E2D\u654C\u4EBA\u5F31\u70B9\u65F6\u63D0\u9AD8\u4F24\u5BB3\u7684\u6BD4\u4F8B"
  - origin: 7
    description: "\u653B\u51FB\u7684\u901F\u5EA6\uFF0C\u63D0\u5347\u5C06\u5141\u8BB8\u4EE5\u66F4\u9AD8\u9891\u7387\u8FDB\u884C\u653B\u51FB"
  - origin: 8
    description: "\u706B\u7130\u4F24\u5BB3\uFF0C\u9B54\u6CD5\u4F24\u5BB3\u4E00\u79CD\u3002\u5BF9\u654C\u4EBA\u9020\u6210\u706B\u7130\u4F24\u5BB3\u5C06\u5BF9\u654C\u4EBA\u65BD\u52A0\u71C3\u70E7\u6548\u679C\uFF08\u6301\u7EED\u9020\u6210\u4F24\u5BB3\uFF09\u3002\u540C\u65F6\u53EA\u80FD\u6709\u4E00\u79CD\u9B54\u6CD5\u6548\u679C\uFF0C\u5F53\u654C\u4EBA\u5904\u4E8E\u67D0\u79CD\u9B54\u6CD5\u72B6\u6001\u65F6\u65E0\u6CD5\u5BF9\u5176\u65BD\u52A0\u53E6\u4E00\u79CD"
  - origin: 9
    description: "\u51B0\u51BB\u4F24\u5BB3\uFF0C\u9B54\u6CD5\u4F24\u5BB3\u4E00\u79CD\u3002\u5BF9\u654C\u4EBA\u9020\u6210\u51B0\u51BB\u4F24\u5BB3\u5C06\u5BF9\u654C\u4EBA\u65BD\u52A0\u51BB\u4F24\u6548\u679C\uFF08\u964D\u4F4E\u62A4\u7532\u5E76\u51CF\u901F\uFF09\u3002\u540C\u65F6\u53EA\u80FD\u6709\u4E00\u79CD\u9B54\u6CD5\u6548\u679C\uFF0C\u5F53\u654C\u4EBA\u5904\u4E8E\u67D0\u79CD\u9B54\u6CD5\u72B6\u6001\u65F6\u65E0\u6CD5\u5BF9\u5176\u65BD\u52A0\u53E6\u4E00\u79CD"
  - origin: 10
    description: "\u96F7\u7535\u4F24\u5BB3\uFF0C\u9B54\u6CD5\u4F24\u5BB3\u4E00\u79CD\u3002\u5BF9\u654C\u4EBA\u9020\u6210\u7535\u51FB\u4F24\u5BB3\u5C06\u5BF9\u654C\u4EBA\u65BD\u52A0\u611F\u7535\u6548\u679C\uFF08\u653B\u51FB\u6709\u51E0\u7387\u4E0D\u9020\u6210\u4F24\u5BB3\uFF0C\u53D7\u653B\u51FB\u65F6\u6709\u51E0\u7387\u5BF9\u5468\u56F4\u611F\u7535\u72B6\u6001\u654C\u4EBA\u53D1\u5C04\u7535\u5F27\uFF09\u3002\u540C\u65F6\u53EA\u80FD\u6709\u4E00\u79CD\u9B54\u6CD5\u6548\u679C\uFF0C\u5F53\u654C\u4EBA\u5904\u4E8E\u67D0\u79CD\u9B54\u6CD5\u72B6\u6001\u65F6\u65E0\u6CD5\u5BF9\u5176\u65BD\u52A0\u53E6\u4E00\u79CD"
  - origin: 11
    description: "\u71C3\u70E7\u6301\u7EED\u65F6\u95F4"
  - origin: 12
    description: "\u51BB\u4F24\u6301\u7EED\u65F6\u95F4"
  - origin: 13
